{
  "name": "@xeboki/sdk",
  "version": "1.0.0",
  "description": "Official Xeboki SDK for TypeScript/JavaScript",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs && node scripts/check-exports.mjs",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --declarationDir dist/types",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "check:exports": "node scripts/check-exports.mjs"
  },
  "keywords": [
    "xeboki",
    "sdk",
    "pos",
    "chat",
    "link",
    "removebg",
    "analytics"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
